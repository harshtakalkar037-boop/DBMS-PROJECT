# ---------------------------------------------------------------------------
# Backend environment. Copy to .env and adjust. NEVER commit .env
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1

# ---------------------------------------------------------------- MySQL -----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=erp_user
DB_PASSWORD=erp_pass_2026
DB_NAME=university_erp
# Optional: talk to the server over its Unix socket instead of TCP. Needed on
# machines where `mysql -u root` works but `mysql -h 127.0.0.1` is refused
# (common on macOS/Homebrew). Find it with: mysql -u root -e "SHOW VARIABLES LIKE 'socket';"
# DB_SOCKET_PATH=/tmp/mysql.sock
DB_CONNECTION_LIMIT=15

# --------------------------------------------------------------- Security ---
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change-this-refresh-secret-too
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ------------------------------------------------------------------ CORS ----
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# ------------------------------------------------- Optional MongoDB (§3) ----
# Leave MONGODB_URI empty to keep everything in MySQL. When it is set, the
# high-volume append-only streams (audit trail + AI conversation history) are
# also mirrored to MongoDB for fast time-series reads.
MONGODB_URI=
MONGODB_DB=university_erp_events

# -------------------------------------------------------- AI assistance -----
# local = deterministic, database-driven engine (default; no external AI call)
# llm   = use the selected provider; configure AI_PROVIDER and its API key
AI_MODE=local
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional OpenAI alternative:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------- Uploads -----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
