flowchart TD
  s1["1. Load examination state and reject<br/>duplicate registration"]
  s2["2. Start transaction; calculate attendance<br/>and outstanding dues"]
  s3["3. Compute dues without applying a dues-<br/>based rejection"]
  s4["4. For low attendance return REJECTED and<br/>rollback"]
  s5["5. Insert eligible registration and hall<br/>ticket; insert trigger also checks<br/>global threshold"]
  s6["6. Write audit / notification; commit, or<br/>rollback on SQL exception"]
  err["SQL exception<br/>ROLLBACK / error outcome"]
  s1 -->|"control / data"| s2
  s2 -->|"control / data"| s3
  s3 -->|"control / data"| s4
  s4 -->|"control / data"| s5
  s5 -->|"control / data"| s6
  s2 -->|"invalid context / SQL failure"| err
