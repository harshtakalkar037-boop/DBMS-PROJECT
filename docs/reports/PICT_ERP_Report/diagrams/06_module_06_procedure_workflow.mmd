flowchart TD
  s1["1. Read application, student and chosen<br/>bed/room context"]
  s2["2. Check active allocations, availability,<br/>gender and capacity before transaction"]
  s3["3. Start transaction; insert ACTIVE<br/>room_allocation"]
  s4["4. Allocation trigger changes physical bed<br/>and occupancy counters"]
  s5["5. Update application; create hostel_fees;<br/>write audit"]
  s6["6. Commit; rollback / resignal on SQL<br/>exception"]
  err["SQL exception<br/>ROLLBACK / error outcome"]
  s1 -->|"control / data"| s2
  s2 -->|"control / data"| s3
  s3 -->|"control / data"| s4
  s4 -->|"control / data"| s5
  s5 -->|"control / data"| s6
  s2 -->|"invalid context / SQL failure"| err
