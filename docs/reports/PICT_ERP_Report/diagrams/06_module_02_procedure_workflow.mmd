flowchart TD
  s1["1. Start transaction; count existing<br/>program/semester pairs"]
  s2["2. Check offering capacity and create<br/>temporary staging table"]
  s3["3. Stage missing pairs for all ACTIVE<br/>students of the program"]
  s4["4. Insert staged enrollments (insert guard<br/>and counter trigger run)"]
  s5["5. Write audit and return counts; commit"]
  s6["6. Normal path drops staging table; SQL<br/>exception rolls back/resignals (no<br/>explicit exception cleanup)"]
  err["SQL exception<br/>ROLLBACK / error outcome"]
  s1 -->|"control / data"| s2
  s2 -->|"control / data"| s3
  s3 -->|"control / data"| s4
  s4 -->|"control / data"| s5
  s5 -->|"control / data"| s6
  s2 -->|"invalid context / SQL failure"| err
