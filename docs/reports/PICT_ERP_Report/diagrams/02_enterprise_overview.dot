digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.15, nodesep=0.32, ranksep=0.65, fontname="Times New Roman", fontsize=13, label="Seven core modules and shared data (overview, not FK-complete)", labelloc=t];
node [fontname="Times New Roman", fontsize=12, shape=box, style="rounded,filled", color="#263b53", fillcolor="#edf2f7", margin="0.13,0.09"];
edge [fontname="Times New Roman", fontsize=9, color="#52657a", arrowsize=0.65];
"shared" [label="Shared masters (12 tables)\nusers / roles / academic context / audit", shape=cylinder, fillcolor="#e9f2ed", style="rounded,filled"];
"m1" [label="1. Student and Admission\nManagement", shape=box, fillcolor="#edf2f7", style="rounded,filled"];
"m2" [label="2. Academic and Course\nManagement", shape=box, fillcolor="#edf2f7", style="rounded,filled"];
"m3" [label="3. Attendance\nManagement", shape=box, fillcolor="#edf2f7", style="rounded,filled"];
"m4" [label="4. Examination and Results", shape=box, fillcolor="#edf2f7", style="rounded,filled"];
"m5" [label="5. Fees and Payments", shape=box, fillcolor="#edf2f7", style="rounded,filled"];
"m6" [label="6. Hostel\nManagement", shape=box, fillcolor="#edf2f7", style="rounded,filled"];
"m7" [label="7. Faculty, HR and Payroll", shape=box, fillcolor="#edf2f7", style="rounded,filled"];
"x" [label="Cross-cutting adjuncts (6 tables)\nmock exams / AI / risk / study plans", shape=box, fillcolor="#f2f2f2", style="rounded,dashed,filled"];
"m1" -> "shared" [label="shared keys / context"];
"m2" -> "shared" [label="shared keys / context"];
"m3" -> "shared" [label="shared keys / context"];
"m4" -> "shared" [label="shared keys / context"];
"m5" -> "shared" [label="shared keys / context"];
"m6" -> "shared" [label="shared keys / context"];
"m7" -> "shared" [label="shared keys / context"];
"m2" -> "m3" [label="offering / enrollment / session"];
"m3" -> "m4" [label="attendance eligibility"];
"m1" -> "m5" [label="student identity"];
"m1" -> "m6" [label="student identity"];
"m7" -> "m2" [label="faculty identity"];
"x" -> "shared" [label="user / student / subject context"];
}