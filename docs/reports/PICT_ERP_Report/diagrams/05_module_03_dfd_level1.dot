"p2" -> "d2" [label="validated writes / query"];
"d2" -> "p2" [label="stored context / rows"];
"actor" -> "p3" [label="request / decision"];
"p3" -> "actor" [label="response / report"];
"p3" -> "d3" [label="validated writes / query"];
"d3" -> "p3" [label="stored context / rows"];
"actor" -> "p4" [label="request / decision"];
