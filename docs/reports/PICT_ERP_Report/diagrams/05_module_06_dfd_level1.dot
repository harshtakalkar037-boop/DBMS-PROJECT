"p4" [label="4.0 Transfer or vacate", shape=ellipse, fillcolor="#e8eef8", style="rounded,filled"];
"d4" [label="D4: room_transfers,\nroom_allocations", shape=cylinder, fillcolor="#e9f2ed", style="rounded,filled"];
"p5" [label="5.0 Reconcile occupancy", shape=ellipse, fillcolor="#e8eef8", style="rounded,filled"];
"d5" [label="D5: beds,\nrooms,\nhostels", shape=cylinder, fillcolor="#e9f2ed", style="rounded,filled"];
"actor" -> "p1" [label="request / decision"];
"p1" -> "actor" [label="response / report"];
"p1" -> "d1" [label="validated writes / query"];
"d1" -> "p1" [label="stored context / rows"];
"actor" -> "p2" [label="request / decision"];
