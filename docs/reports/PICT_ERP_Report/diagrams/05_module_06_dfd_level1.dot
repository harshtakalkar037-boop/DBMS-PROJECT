digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.15, nodesep=0.32, ranksep=0.65, fontname="Times New Roman", fontsize=13, label="Module 6 — Level 1 DFD", labelloc=t];
node [fontname="Times New Roman", fontsize=12, shape=box, style="rounded,filled", color="#263b53", fillcolor="#edf2f7", margin="0.13,0.09"];
edge [fontname="Times New Roman", fontsize=9, color="#52657a", arrowsize=0.65];
"actor" [label="M6 actors\nAuthorized users / staff", shape=box, fillcolor="#ffffff", style="filled"];
"p1" [label="1.0 Maintain inventory /\nfind vacancy", shape=ellipse, fillcolor="#e8eef8", style="rounded,filled"];
"d1" [label="D1: hostels,\nhostel_blocks,\nrooms,\nbeds", shape=cylinder, fillcolor="#e9f2ed", style="rounded,filled"];
"p2" [label="2.0 Submit /\nreview application", shape=ellipse, fillcolor="#e8eef8", style="rounded,filled"];
"d2" [label="D2: hostel_applications", shape=cylinder, fillcolor="#e9f2ed", style="rounded,filled"];
"p3" [label="3.0 Allocate bed /\nbill rent", shape=ellipse, fillcolor="#e8eef8", style="rounded,filled"];
