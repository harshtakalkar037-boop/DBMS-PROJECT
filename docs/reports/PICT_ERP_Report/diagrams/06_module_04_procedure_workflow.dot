digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.15, nodesep=0.32, ranksep=0.65, fontname="Times New Roman", fontsize=13, label="sp_register_student_for_exam — implementation-derived decomposition", labelloc=t];
node [fontname="Times New Roman", fontsize=12, shape=box, style="rounded,filled", color="#263b53", fillcolor="#edf2f7", margin="0.13,0.09"];
edge [fontname="Times New Roman", fontsize=9, color="#52657a", arrowsize=0.65];
"s1" [label="1. Load examination state and reject\nduplicate registration", shape=ellipse, fillcolor="#e8eef8", style="rounded,filled"];
"s2" [label="2. Start transaction; calculate attendance\nand outstanding dues", shape=ellipse, fillcolor="#e8eef8", style="rounded,filled"];
"s3" [label="3. Compute dues without applying a dues-\nbased rejection", shape=ellipse, fillcolor="#e8eef8", style="rounded,filled"];
"s4" [label="4. For low attendance return REJECTED and\nrollback", shape=ellipse, fillcolor="#e8eef8", style="rounded,filled"];
"s5" [label="5. Insert eligible registration and hall\nticket; insert trigger also checks\nglobal threshold", shape=ellipse, fillcolor="#e8eef8", style="rounded,filled"];
"s6" [label="6. Write audit / notification; commit, or\nrollback on SQL exception", shape=ellipse, fillcolor="#e8eef8", style="rounded,filled"];
"err" [label="SQL exception\nROLLBACK / error outcome", shape=box, fillcolor="#f2f2f2", style="rounded,dashed,filled"];
"s1" -> "s2" [label="control / data"];
"s2" -> "s3" [label="control / data"];
"s3" -> "s4" [label="control / data"];
"s4" -> "s5" [label="control / data"];
"s5" -> "s6" [label="control / data"];
"s2" -> "err" [label="invalid context / SQL failure"];
}