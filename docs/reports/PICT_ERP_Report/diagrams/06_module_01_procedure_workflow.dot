digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.15, nodesep=0.32, ranksep=0.65, fontname="Times New Roman", fontsize=13, label="sp_approve_admission — implementation-derived decomposition", labelloc=t];
node [fontname="Times New Roman", fontsize=12, shape=box, style="rounded,filled", color="#263b53", fillcolor="#edf2f7", margin="0.13,0.09"];
edge [fontname="Times New Roman", fontsize=9, color="#52657a", arrowsize=0.65];
"s1" [label="1. Validate decision and begin transaction", shape=ellipse, fillcolor="#e8eef8", style="rounded,filled"];
"s2" [label="2. Lock application; reject missing or\nalready reviewed state", shape=ellipse, fillcolor="#e8eef8", style="rounded,filled"];
"s3" [label="3. For rejection: update application and\naudit, then commit", shape=ellipse, fillcolor="#e8eef8", style="rounded,filled"];
"s4" [label="4. For approval: validate supplied hash,\nprogram, active batch and STUDENT role", shape=ellipse, fillcolor="#e8eef8", style="rounded,filled"];
"s5" [label="5. Create users, students and guardians;\nlink approved application", shape=ellipse, fillcolor="#e8eef8", style="rounded,filled"];
"s6" [label="6. Write audit / notification; commit;\nrollback and resignal SQL exceptions", shape=ellipse, fillcolor="#e8eef8", style="rounded,filled"];
"err" [label="SQL exception\nROLLBACK / error outcome", shape=box, fillcolor="#f2f2f2", style="rounded,dashed,filled"];
"s1" -> "s2" [label="control / data"];
"s2" -> "s3" [label="control / data"];
"s3" -> "s4" [label="control / data"];
"s4" -> "s5" [label="control / data"];
"s5" -> "s6" [label="control / data"];
"s2" -> "err" [label="invalid context / SQL failure"];
}